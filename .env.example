# DelphiPulse Environment Configuration Example
# Network Profile: competition-testnet or mainnet
DELPHI_NETWORK=competition-testnet

# Agent Identification Headers
DELPHI_AGENT_ID=delphipulse-miner-v1
DELPHI_AGENT_HARNESS=gensyn-evidence-miner
DELPHI_AGENT_MODEL=delphipulse-lmsr-v1

# Delphi API Authentication (Optional for public endpoints)
DELPHI_API_ACCESS_KEY=your_delphi_api_key_here

# Payout Wallet & Gateway Address (Set via environment variables)
DELPHI_WALLET_ADDRESS=
DELPHI_GATEWAY_CONTRACT=

# Timeout & Safety Parameters
DELPHI_REQUEST_TIMEOUT=12.0
DELPHI_CUTOFF_SAFETY_SEC=1800
